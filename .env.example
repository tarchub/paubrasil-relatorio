# ===========================================================================
# Market Radar USA — variáveis de ambiente
# Copie para .env.local e preencha. NUNCA versione .env.local com valores reais.
# ===========================================================================

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Supabase (obrigatório) ----
# Painel Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon...
# service_role: SOMENTE no servidor. Nunca exponha no frontend.
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...

# ---- Inteligência Artificial (obrigatório para o pipeline de IA) ----
# Provedor: "anthropic" ou "openai"
AI_PROVIDER=anthropic

# Anthropic (se AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI (se AI_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ---- Cron (obrigatório em produção) ----
# String aleatória. Os cron jobs enviam Authorization: Bearer $CRON_SECRET
CRON_SECRET=troque-por-uma-string-aleatoria-forte

# ---- Coleta (opcional / Fase 2-3) ----
# Product Hunt (GraphQL API) — api.producthunt.com
PRODUCT_HUNT_TOKEN=
# Reddit — reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# YouTube Data API — Google Cloud Console
YOUTUBE_API_KEY=
# SerpApi (Google Trends / SERP) — serpapi.com
SERPAPI_KEY=

# ---- Desenvolvimento ----
# "true" habilita mock data APENAS para construir a UI. Nunca em produção.
NEXT_PUBLIC_USE_MOCKS=false
